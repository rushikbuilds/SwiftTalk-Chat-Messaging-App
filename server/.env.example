# Server & Runtime Environment
PORT=3001
NODE_ENV=development
SESSION_SECRET=your_session_secret_key_here

# URLs & CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Database Configuration (MySQL / Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/swifttalk"

# Database Configuration (MongoDB - High-throughput Chats & Messages)
MONGODB_URI="mongodb://localhost:27017/swifttalk"

# Redis Configuration (Session & Socket Store)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth 2.0 - Google (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# OAuth 2.0 - GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Web Push Notifications (VAPID Keys)
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@example.com

# Email / OTP Service (Resend - https://resend.com)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="SwiftTalk <onboarding@resend.dev>"

# AI Integration (GroqCloud - https://console.groq.com/)
AI_API_KEY=your_groq_api_key
AI_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7

# File Uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
