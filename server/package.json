{
  "name": "server",
  "version": "1.2.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "npx prisma migrate deploy && node src/server.js",
    "start:api": "node src/server.js",
    "start:ws": "node src/wsServer.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "dev": "concurrently -n \"API,WS\" -c \"blue,green\" \"nodemon src/server.js\" \"nodemon src/wsServer.js\"",
    "dev:api": "nodemon src/server.js",
    "dev:ws": "nodemon src/wsServer.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:prod": "dotenv -e .env.production -- prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:migrate:mongo": "node src/scripts/migrateToMongo.js",
    "db:reset:seed": "npm run db:clear && npx prisma db push && npm run db:seed",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "coverage": "jest --coverage --forceExit --detectOpenHandles",
    "coverage:html": "jest --coverage --coverageReporters=html --forceExit --detectOpenHandles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.1.47",
    "@langchain/groq": "^1.2.1",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^6.19.3",
    "redis": "^5.10.0",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
